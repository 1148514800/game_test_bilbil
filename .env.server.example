# 此文件只展示服务端变量名称，不包含真实密钥。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# 第三方兼容接口通常填写 chat_completions；支持 Responses API 时可填写 responses。
OPENAI_API_MODE=chat_completions
AI_SERVER_PORT=8787
AI_REQUEST_TIMEOUT_MS=10000
AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
